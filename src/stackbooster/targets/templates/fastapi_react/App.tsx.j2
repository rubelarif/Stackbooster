// Router generated by stackbooster: one route per legacy page.
import { BrowserRouter, Route, Routes } from "react-router-dom";
{% for item in layouts %}
import {{ item.target_name }} from "./components/{{ item.target_name }}";
{% endfor %}
{% for item in pages %}
import {{ item.target_name }} from "./pages/{{ item.target_name }}";
{% endfor %}

export default function App() {
  return (
    <BrowserRouter>
{% for item in layouts %}
      <{{ item.target_name }} />
{% endfor %}
      <Routes>
{% for item in pages %}
        <Route path="{{ item.details.route_path }}" element={<{{ item.target_name }} />} />
{% endfor %}
      </Routes>
    </BrowserRouter>
  );
}
