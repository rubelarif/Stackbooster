// {{ item.target_name }}: rebuilt from legacy {{ item.legacy_file }}. Generated by stackbooster.
{% for note in item.notes %}
// NOTE: {{ note }}
{% endfor %}
import { useEffect, useState } from "react";
{% if item.details.path_params %}
import { useParams } from "react-router-dom";
{% endif %}

export default function {{ item.target_name }}() {
  const [data, setData] = useState<unknown>(null);
{% if item.details.path_params %}
  const { {{ item.details.path_params | join(", ") }} } = useParams();
{% endif %}

  useEffect(() => {
    document.title = {{ (item.details.title or item.target_name) | tojson }};
{% if item.details.data_endpoint %}
    // Data the legacy page loaded on the server: {{ item.details.data_endpoint }}
{% if item.details.path_params %}
    fetch(`{{ item.details.data_endpoint.split(" ", 1)[1] }}?{% for p in item.details.path_params %}{{ p }}=${encodeURIComponent({{ p }} ?? "")}{{ "&" if not loop.last }}{% endfor %}`, { credentials: "include" })
{% else %}
    fetch("{{ item.details.data_endpoint.split(" ", 1)[1] }}", { credentials: "include" })
{% endif %}
      .then((r) => r.json())
      .then(setData);
{% endif %}
  }, [{{ item.details.path_params | join(", ") }}]);

  return (
    <main>
      <h1>{{ item.details.title or item.target_name }}</h1>
{% for form in item.details.forms %}
      {/* {{ form.component }}: submits to {{ form.submits_to }} */}
      <form onSubmit={(e) => { e.preventDefault(); /* TODO */ }}>
{% for f in form.fields %}
        <input name="{{ f.name }}" type="{{ f.type if f.type not in ("select", "textarea") else "text" }}"{% if f.required %} required{% endif %} />
{% endfor %}
        <button type="submit">Submit</button>
      </form>
{% endfor %}
{% for call in item.details.api_calls %}
      {/* Legacy call {{ call.legacy }} -> {{ call.endpoint }} */}
{% endfor %}
      <pre>{JSON.stringify(data, null, 2)}</pre>
    </main>
  );
}
